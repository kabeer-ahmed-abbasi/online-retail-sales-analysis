        "lineageTag": "2542eb55-bf8b-4f7f-844d-1db151b35901",
        "measures": [
          {
            "name": "Total Revenue",
            "expression": "SUM ( Sales[Revenue] )",
            "formatString": "£#,0",
            "lineageTag": "e180f8be-e0e7-44c3-9557-20e85b6205bb"
          },
          {
            "name": "Orders",
            "expression": "DISTINCTCOUNT ( Sales[InvoiceNo] )",
            "formatString": "#,0",
            "lineageTag": "37674851-8433-46b9-a02e-3be9bb2b0de9"
          },
          {
            "name": "Customers",
            "expression": "DISTINCTCOUNTNOBLANK ( Sales[CustomerID] )",
            "formatString": "#,0",
            "lineageTag": "9b4d4a47-9fd9-43e6-bb0a-53f8ebfb1bb6"
          },
          {
            "name": "Avg Order Value",
            "expression": "DIVIDE ( [Total Revenue], [Orders] )",
            "formatString": "£#,0.00",
            "lineageTag": "feb2fcd5-9a58-4004-9b39-4d7cdada4a30"
          },
          {
            "name": "Top 10 Product Revenue",
            "expression": [
              "VAR r = RANKX ( ALLSELECTED ( Sales[Product] ), [Total Revenue], , DESC )",
              "RETURN IF ( NOT ISBLANK ( [Total Revenue] ) && r <= 10, [Total Revenue] )"
            ],
            "formatString": "£#,0",
            "lineageTag": "70962849-f5e2-44b4-916a-505e7ed4e05b"
          },
          {
            "name": "Top 10 Country Revenue",
            "expression": [
              "VAR r = RANKX ( ALLSELECTED ( Sales[Country] ), [Total Revenue], , DESC )",
              "RETURN IF ( NOT ISBLANK ( [Total Revenue] ) && r <= 10, [Total Revenue] )"
            ],
            "formatString": "£#,0",
            "lineageTag": "176722da-4846-4437-950f-7e20afc3dd59"
          }
        ],
        "partitions": [
          {
            "name": "Sales",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(CsvPath), [Delimiter = \",\", Columns = 8, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),",
                "    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),",
                "    Typed = Table.TransformColumnTypes(Promoted, {{\"InvoiceNo\", type text}, {\"StockCode\", type text}, {\"Description\", type text}, {\"Quantity\", Int64.Type}, {\"InvoiceDate\", type number}, {\"UnitPrice\", type number}, {\"CustomerID\", type text}, {\"Country\", type text}}, \"en-US\"),",
                "    NonProduct = {\"POST\", \"DOT\", \"M\", \"m\", \"C2\", \"D\", \"S\", \"BANK CHARGES\", \"AMAZONFEE\", \"CRUK\", \"PADS\", \"B\"},",
                "    Cleaned = Table.SelectRows(Typed, each not Text.StartsWith([InvoiceNo], \"C\") and [Quantity] > 0 and [UnitPrice] > 0 and not List.Contains(NonProduct, [StockCode]) and not Text.StartsWith([StockCode], \"gift_\")),",
                "    BlankIds = Table.ReplaceValue(Cleaned, \"\", null, Replacer.ReplaceValue, {\"CustomerID\"}),",
                "    AddDate = Table.AddColumn(BlankIds, \"Invoice Date\", each #datetime(1899, 12, 30, 0, 0, 0) + Duration.From([InvoiceDate]), type datetime),",
                "    AddRevenue = Table.AddColumn(AddDate, \"Revenue\", each [Quantity] * [UnitPrice], type number),",
                "    AddYear = Table.AddColumn(AddRevenue, \"Year\", each Date.Year([Invoice Date]), Int64.Type),",
                "    AddMonthNo = Table.AddColumn(AddYear, \"Month No\", each Date.Month([Invoice Date]), Int64.Type),",
                "    AddMonth = Table.AddColumn(AddMonthNo, \"Month\", each Date.ToText(DateTime.Date([Invoice Date]), \"MMM\", \"en-GB\"), type text),",
                "    AddMonthStart = Table.AddColumn(AddMonth, \"Month Start\", each Date.StartOfMonth(DateTime.Date([Invoice Date])), type date),",
                "    AddProduct = Table.AddColumn(AddMonthStart, \"Product\", each if [Description] = null then [StockCode] else Text.Proper(Text.Trim([Description])), type text),",
                "    AddMapCountry = Table.AddColumn(AddProduct, \"Map Country\", each",
                "        if [Country] = \"EIRE\" then \"Ireland\"",
                "        else if [Country] = \"RSA\" then \"South Africa\"",
                "        else if [Country] = \"USA\" then \"United States\"",
                "        else if [Country] = \"Channel Islands\" then \"Jersey\"",
                "        else if [Country] = \"European Community\" or [Country] = \"Unspecified\" then null",
                "        else [Country], type text),",
                "    Result = Table.RemoveColumns(AddMapCountry, {\"InvoiceDate\", \"Description\"})",
                "in",
                "    Result"
              ],
              "type": "m"
            }
          }
        ]
      },
